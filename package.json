{
  "name": "game-prototypes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node tools/scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check-rules": "node tools/scripts/check-rules.mjs",
    "playtest": "node tools/scripts/playtest.mjs",
    "sim": "node tools/scripts/sim.mjs",
    "verify": "node tools/scripts/verify.mjs",
    "format": "prettier --write .",
    "format:edited": "node tools/scripts/format-edited.mjs",
    "agent:status": "node tools/scripts/agent-status.mjs",
    "new-proto": "node tools/scripts/new-proto.mjs",
    "log-change": "node tools/scripts/log-change.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.1.14",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
