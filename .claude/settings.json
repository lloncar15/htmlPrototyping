{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm check-rules *)",
      "Bash(pnpm playtest *)",
      "Bash(pnpm sim *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm new-proto *)",
      "Bash(pnpm log-change *)",
      "Bash(pnpm format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm playtest * --update)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "pnpm --silent format:edited", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "pnpm --silent agent:status", "timeout": 30 }]
      }
    ]
  }
}
